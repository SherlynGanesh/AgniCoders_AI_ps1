DATABASE_URL=postgresql://postgres:<PASSWORD>@localhost:5432/dukaanmitra
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dukaanmitra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Application Settings
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Semantic Search & Embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
USE_PGVECTOR=True

# Data Directory
DATA_DIR=./data
